# Copia in .env.local (sviluppo) o imposta come Environment Variables su Vercel.

# Stringa di connessione Postgres (Vercel Postgres / Neon / Supabase).
# In locale con Docker: postgresql://vdi:vdi_local_dev@localhost:5432/vdi_booking
DATABASE_URL=

# Stringa casuale lunga: firma le sessioni JWT e cifra le password nel vault.
# ATTENZIONE: cambiarla invalida le sessioni e rende illeggibili le password salvate.
# Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Codice della risorsa VDI usata per le prenotazioni (default: VDI-AI-01).
VDI_RESOURCE_CODE=VDI-AI-01
